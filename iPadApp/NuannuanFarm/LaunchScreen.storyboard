<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="ipad11_0rounded" orientation="landscape" layout="fullscreen"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23501"/><capability name="Safe area layout guides" minToolsVersion="9.0"/></dependencies>
    <scenes><scene sceneID="launch-scene"><objects>
        <viewController id="launch-controller" sceneMemberID="viewController"><view key="view" contentMode="scaleToFill" id="launch-view">
            <rect key="frame" x="0.0" y="0.0" width="1194" height="834"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="✿" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-flower">
                    <rect key="frame" x="565" y="311" width="64" height="72"/>
                    <fontDescription key="fontDescription" type="system" pointSize="60"/>
                    <color key="textColor" red="0.39" green="0.49" blue="0.31" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="暖暖的小农场" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-title">
                    <rect key="frame" x="470" y="405" width="254" height="41"/>
                    <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="32"/>
                    <color key="textColor" red="0.21" green="0.29" blue="0.22" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="不着急，小脚丫慢慢走。" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-subtitle">
                    <rect key="frame" x="483" y="463" width="228" height="18"/>
                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                    <color key="textColor" red="0.48" green="0.53" blue="0.43" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
            </subviews>
            <viewLayoutGuide key="safeArea" id="launch-safe"/>
            <color key="backgroundColor" red="0.98" green="0.97" blue="0.94" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints>
                <constraint firstItem="launch-flower" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="flower-x"/>
                <constraint firstItem="launch-flower" firstAttribute="bottom" secondItem="launch-title" secondAttribute="top" constant="-22" id="flower-y"/>
                <constraint firstItem="launch-title" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="title-x"/>
                <constraint firstItem="launch-title" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" id="title-y"/>
                <constraint firstItem="launch-subtitle" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="subtitle-x"/>
                <constraint firstItem="launch-subtitle" firstAttribute="top" secondItem="launch-title" secondAttribute="bottom" constant="17" id="subtitle-y"/>
            </constraints>
        </view></viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
</document>
